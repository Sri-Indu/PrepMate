# Copy this file to .env and adjust as needed.
# Never commit a real .env file or API keys.

# --- Server ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# --- Open-weight LLM (Ollama, free/local) ---
# Provider is swappable later without rewriting the app.
# Default model is small so a normal laptop can run it.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=gemma2:2b
# Ollama does not require a key. Leave empty for local use.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120

# --- Embeddings / RAG (open model, runs locally, no API key) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=4

# --- Storage ---
# SQLite file for interview sessions/history. Resume PDFs are not kept.
DATABASE_PATH=./backend/data/prepmate.db

# Max upload size for resume/JD PDFs (bytes). Files are not written to disk.
MAX_UPLOAD_BYTES=5242880
